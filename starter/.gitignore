# Dependencies — restored by `npm ci`, never committed
node_modules/

# Playwright output — regenerated on every run
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

# Personal practice files — never committed
/scratch/

# Observability data — raw results, imported history and generated reports stay local
/results/
/observability/history/
/observability/out/
