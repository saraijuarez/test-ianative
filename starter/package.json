{
  "name": "ai-native-starter",
  "version": "1.0.0",
  "private": true,
  "description": "Recovery Playwright + TypeScript project for the AI-Native Test Automation Engineering course (Lab 0).",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "obs:import": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON observability/cli.ts import",
    "obs:report": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON observability/cli.ts report",
    "obs:test": "playwright test --config=observability/playwright.unit.config.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2"
  }
}
